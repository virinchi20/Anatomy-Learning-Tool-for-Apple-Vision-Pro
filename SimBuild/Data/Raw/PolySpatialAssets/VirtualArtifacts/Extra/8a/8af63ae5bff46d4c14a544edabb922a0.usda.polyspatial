#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def "MaterialX"
{
    def "Materials"
    {
        def Material "USD_UnlitClippableShader"
        {
            float3 inputs:_PlanePosition = (0, 0, 0)
            float3 inputs:_PlaneNormal = (0, 1, 0)
            color4f inputs:_BaseColor = (0, 0, 0, 0)
            float inputs:_Alpha = 1
            float inputs:_PlaneEnabled = 1

            token outputs:mtlx:surface.connect = <realitykit_unlit.outputs:out>
            token outputs:realitykit:vertex.connect = <GeometryModifier.outputs:out>

            def Shader "realitykit_unlit"
            {
                uniform token info:id = "ND_realitykit_unlit_surfaceshader"
                bool inputs:applyPostProcessToneMap = 0
                color3f inputs:color.connect = <../_14.outputs:out>
                float inputs:opacity.connect = <../.inputs:_Alpha>
                float inputs:opacityThreshold.connect = <../_9.outputs:out>
                token outputs:out
            }

            def Shader "GeometryModifier"
            {
                uniform token info:id = "ND_realitykit_geometrymodifier_vertexshader"
                token outputs:out
            }

            def Shader "_14"
            {
                uniform token info:id = "ND_swizzle_color4_color3"
                color4f inputs:in.connect = <../.inputs:_BaseColor>
                string inputs:channels = "rgb"
                color3f outputs:out
            }

            def Shader "_9"
            {
                uniform token info:id = "ND_ifgreater_float"
                float inputs:in1.connect = <../_1.outputs:out>
                float inputs:in2 = 0
                float inputs:value1.connect = <../_10.outputs:out>
                float outputs:out
            }

            def Shader "_1"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = <../_2.outputs:out>
                float inputs:in2 = 2
                float outputs:out
            }

            def Shader "_2"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in2.connect = <../_3.outputs:out>
                float inputs:in1 = 1
                float outputs:out
            }

            def Shader "_3"
            {
                uniform token info:id = "ND_ifgreatereq_float"
                float inputs:value2 = 0
                float inputs:value1.connect = <../_4.outputs:out>
                float inputs:in1 = 1
                float inputs:in2 = 0
                float outputs:out
            }

            def Shader "_4"
            {
                uniform token info:id = "ND_dotproduct_vector3"
                float3 inputs:in1.connect = <../_5.outputs:out>
                float3 inputs:in2.connect = <../.inputs:_PlaneNormal>
                float outputs:out
            }

            def Shader "_5"
            {
                uniform token info:id = "ND_subtract_vector3"
                float3 inputs:in1.connect = <../_13.outputs:out>
                float3 inputs:in2.connect = <../.inputs:_PlanePosition>
                float3 outputs:out
            }

            def Shader "_13"
            {
                uniform token info:id = "ND_swizzle_vector4_vector3"
                float4 inputs:in.connect = <../_6.outputs:out>
                string inputs:channels = "xyz"
                float3 outputs:out
            }

            def Shader "_6"
            {
                uniform token info:id = "ND_convert_vector3_vector4"
                float3 inputs:in.connect = <../_7.outputs:out>
                float4 outputs:out
            }

            def Shader "_7"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = <../_8.outputs:out>
                float3 inputs:in2 = (1, 1, -1)
                float3 outputs:out
            }

            def Shader "_8"
            {
                uniform token info:id = "ND_position_vector3"
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "_10"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = <../.inputs:_PlaneEnabled>
                float outputs:out
            }
        }
    }
}
