            }

            def Shader "_18"
            {
                uniform token info:id = "ND_swizzle_vector4_vector2"
                float4 inputs:in.connect = <../.inputs:TextureTransform_Texture2DAsset_9066c06ab90b4cdea049cac2158c4844_Out_0_Texture2D>
                string inputs:channels = "xy"
